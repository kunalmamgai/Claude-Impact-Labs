GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_DEMO_MODE=false

# Public Render API origin used by browser requests in the Vercel frontend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Server-only Render origin used by authenticated Vercel proxy routes.
BACKEND_URL=http://localhost:4000
# Comma-separated frontend origins accepted by the Render API.
FRONTEND_ORIGIN=http://localhost:5173

LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.example.com/v1/chat/completions
LLM_MODEL=your-model-name
PORT=5173
SNAPSHOT_DIR=./data/snapshots
ADMIN_API_KEY=change-me
